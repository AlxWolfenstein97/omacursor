#!/usr/bin/python3
"""omacursor-sync-sddm — publish user Omarchy cursors for SDDM + refresh wiring.

Must run as root (sudo -n from omacursor apply when sddm-linked).

NEVER touches /usr/share/icons/Adwaita/ — that circular symlink broke GTK/Qt.
Instead we publish Omarchy and a self-contained /usr/share/icons/default/cursors.
"""

from __future__ import annotations

import os
import posixpath
import pwd
import shutil
import stat
import sys
import tempfile
import time
from pathlib import Path

CONF = Path("/etc/sddm.conf.d/99-omacursor.conf")
SUDOERS = Path("/etc/sudoers.d/omacursor_sddm")
SYSTEM_ICONS = Path("/usr/share/icons/Omarchy")
DEFAULT_DIR = Path("/usr/share/icons/default")
DEFAULT_THEME = DEFAULT_DIR / "index.theme"
DEFAULT_BAK = DEFAULT_DIR / "index.theme.omacursor-bak"
DEFAULT_CURSORS = DEFAULT_DIR / "cursors"
DEFAULT_CURSORS_PREBAK = DEFAULT_DIR / "cursors.omacursor-prebak"
# Ownership marker lives *inside* the cursors tree so a user-replaced
# destination cannot inherit a leftover sibling marker.
DEFAULT_CURSORS_OWNED = DEFAULT_CURSORS / ".omacursor-owned"
DEFAULT_CURSORS_OWNED_LEGACY = DEFAULT_DIR / ".omacursor-cursors-owned"
ADWAITA_CURSORS = Path("/usr/share/icons/Adwaita/cursors")
ADWAITA_CURSORS_BAK = Path("/usr/share/icons/Adwaita/cursors.omacursor-stock")
SDDM_BASE = Path("/var/lib/sddm")
SDDM_INDEX = (
    "# Managed by OmaCursor — SDDM default icon theme\n"
    "[Icon Theme]\n"
    "Name=default\n"
    "Inherits=hicolor\n"
)
SDDM_CURSORS_PREBAK_NAME = "cursors.omacursor-prebak"
OWNED_MARKER = ".omacursor-owned"
LIBDIR = Path("/usr/local/lib/omacursor")
COMPOSITOR = LIBDIR / "sddm-compositor"
HYPR_CFG = Path("/etc/sddm/omacursor-hyprland.lua")
LOG = Path("/var/log/omacursor-sddm.log")

HYPR_LUA = """\
-- Managed by OmaCursor. Based on Omarchy's /usr/share/sddm/hyprland.lua.
hl.env("XCURSOR_THEME", "Omarchy")
hl.env("XCURSOR_SIZE", "{size}")

hl.config({{
  misc = {{
    disable_hyprland_logo = true,
    disable_splash_rendering = true,
    force_default_wallpaper = 0,
  }},

  animations = {{
    enabled = false,
  }},
}})

hl.exec_cmd("hyprctl setcursor Omarchy {size}")
"""

COMPOSITOR_SH = """\
#!/bin/bash
# Managed by OmaCursor — SDDM Wayland compositor wrapper.
export XCURSOR_THEME=Omarchy
export XCURSOR_SIZE={size}
{{
  printf '%s pid=%s XCURSOR_THEME=%s config=%s\\n' \\
    "$(date -Is)" "$$" "$XCURSOR_THEME" /etc/sddm/omacursor-hyprland.lua
}} >>/var/log/omacursor-sddm.log 2>/dev/null || true
exec /usr/bin/start-hyprland -- --config /etc/sddm/omacursor-hyprland.lua
"""


def invoking_home() -> Path:
    user = os.environ.get("SUDO_USER")
    if not user and os.environ.get("PKEXEC_UID", "").isdigit():
        try:
            user = pwd.getpwuid(int(os.environ["PKEXEC_UID"])).pw_name
        except KeyError:
            user = None
    if user:
        try:
            return Path(pwd.getpwnam(user).pw_dir)
        except KeyError:
            pass
    for marker in sorted(Path("/home").glob("*/.local/state/omarchy/omacursor/sddm-linked")):
        return marker.parents[4]
    return Path("/nonexistent")


def resolve_src(home: Path) -> Path | None:
    icons = home / ".local/share/icons"
    stable = icons / "Omarchy"
    if stable.is_symlink():
        target = Path(os.readlink(stable))
        if not target.is_absolute():
            target = stable.parent / target
        # Do not fall through to a slot when the stable link is broken: a
        # hostile link must be rejected, not silently replaced.
        return target if target.is_dir() else None
    if stable.is_dir():
        return stable
    for slot in ("Omarchy-a", "Omarchy-b"):
        candidate = icons / slot
        if candidate.is_dir():
            return candidate
    return None


def invoking_uid(home: Path) -> int | None:
    user = os.environ.get("SUDO_USER")
    if user:
        try:
            return pwd.getpwnam(user).pw_uid
        except KeyError:
            return None
    if os.environ.get("PKEXEC_UID", "").isdigit():
        try:
            return pwd.getpwuid(int(os.environ["PKEXEC_UID"])).pw_uid
        except KeyError:
            return None
    try:
        return pwd.getpwnam(home.name).pw_uid
    except KeyError:
        return None


def _within(child: Path, parent: Path) -> bool:
    try:
        child.resolve().relative_to(parent.resolve())
        return True
    except (ValueError, OSError):
        return False


def _owned_by(path: Path, uid: int) -> bool:
    try:
        return path.stat().st_uid == uid
    except OSError:
        return False


def _safe_symlinks(root: Path) -> bool:
    """Reject absolute or escaping symlinks anywhere in a cursor tree."""
    for dirpath, dirnames, filenames in os.walk(root, followlinks=False):
        for name in (*dirnames, *filenames):
            path = Path(dirpath) / name
            if not path.is_symlink():
                continue
            target = os.readlink(path)
            if os.path.isabs(target):
                return False
            if not _within(path.parent / target, root):
                return False
    return True


# --------------------------------------------------------------------------
# fd-relative helpers. The helper runs as root for a user who can change the
# source tree at any time, so path lookups must never follow a symlink and must
# not trust a stat taken a moment earlier.
# --------------------------------------------------------------------------

_O_DIR = (
    os.O_RDONLY
    | os.O_DIRECTORY
    | getattr(os, "O_NOFOLLOW", 0)
    | getattr(os, "O_CLOEXEC", 0)
)
_O_RD = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_CLOEXEC", 0)
_NOFOLLOW = getattr(os, "O_NOFOLLOW", 0)


def _entry_stat(dir_fd: int, name: str) -> os.stat_result | None:
    try:
        return os.stat(name, dir_fd=dir_fd, follow_symlinks=False)
    except FileNotFoundError:
        return None


def _entry_mode(dir_fd: int, name: str) -> int | None:
    st = _entry_stat(dir_fd, name)
    return st.st_mode if st is not None else None


def _rename_at(dir_fd: int, old: str, new: str) -> None:
    os.rename(old, new, src_dir_fd=dir_fd, dst_dir_fd=dir_fd)


def _rename_aside(dir_fd: int, name: str, stem: str) -> str:
    stamp = f"{time.strftime('%Y%m%d%H%M%S')}-{os.getpid()}"
    candidate = f"{stem}.{stamp}"
    while _entry_mode(dir_fd, candidate) is not None:
        candidate += "x"
    _rename_at(dir_fd, name, candidate)
    return candidate


def _safe_relative_link(rel: str, target: str) -> bool:
    """A copied symlink may be relative but must not escape the tree."""
    if not target or os.path.isabs(target):
        return False
    parent = posixpath.dirname(rel)
    resolved = posixpath.normpath(posixpath.join(parent, target))
    return resolved != ".." and not resolved.startswith("../")


def _copy_tree_nofollow(src: Path, dst: Path, uid: int | None = None) -> None:
    """Copy a cursor tree without ever following a symlink.

    ``shutil.copytree`` stats each entry before copying it, so a user can race a
    regular file into a directory symlink between validation and copy and have
    the root helper publish arbitrary root-readable files. Every lookup here is
    relative to an already-open directory with ``O_NOFOLLOW``; only regular
    files and safe relative symlinks are reproduced. With *uid* set, every entry
    must belong to the invoking user.
    """
    src_fd = os.open(src, _O_DIR)
    try:
        os.mkdir(dst, 0o755)
        dst_fd = os.open(dst, _O_DIR)
        try:
            _copy_entries(src_fd, dst_fd, "", uid)
        finally:
            os.close(dst_fd)
    finally:
        os.close(src_fd)


def _copy_entries(src_fd: int, dst_fd: int, rel: str, uid: int | None) -> None:
    # os.scandir(fd) would take ownership of the descriptor; listdir does not.
    for name in os.listdir(src_fd):
        st = _entry_stat(src_fd, name)
        if st is None:
            continue  # entry vanished mid-copy; the published tree stays consistent
        if uid is not None and st.st_uid != uid:
            raise RuntimeError(f"cursor entry not owned by the invoking user: {rel}{name}")
        if stat.S_ISLNK(st.st_mode):
            target = os.readlink(name, dir_fd=src_fd)
            if not _safe_relative_link(rel + name, target):
                raise RuntimeError(f"cursor tree has an unsafe symlink: {rel}{name}")
            os.symlink(target, name, dir_fd=dst_fd)
        elif stat.S_ISDIR(st.st_mode):
            child_src = os.open(name, _O_DIR, dir_fd=src_fd)
            try:
                opened = os.fstat(child_src)
                if (opened.st_dev, opened.st_ino) != (st.st_dev, st.st_ino):
                    raise RuntimeError(f"cursor tree entry changed while copying: {rel}{name}")
                os.mkdir(name, 0o755, dir_fd=dst_fd)
                child_dst = os.open(name, _O_DIR, dir_fd=dst_fd)
                try:
                    _copy_entries(child_src, child_dst, f"{rel}{name}/", uid)
                finally:
                    os.close(child_dst)
            finally:
                os.close(child_src)
        elif stat.S_ISREG(st.st_mode):
            _copy_regular(src_fd, dst_fd, name, st, rel, uid)
        else:
            raise RuntimeError(f"cursor tree has a special file: {rel}{name}")


def _copy_regular(
    src_fd: int,
    dst_fd: int,
    name: str,
    expected: os.stat_result,
    rel: str,
    uid: int | None,
) -> None:
    in_fd = os.open(name, _O_RD, dir_fd=src_fd)
    try:
        opened = os.fstat(in_fd)
        if not stat.S_ISREG(opened.st_mode) or (opened.st_dev, opened.st_ino) != (
            expected.st_dev,
            expected.st_ino,
        ):
            raise RuntimeError(f"cursor tree entry changed while copying: {rel}{name}")
        if uid is not None and opened.st_uid != uid:
            raise RuntimeError(f"cursor entry not owned by the invoking user: {rel}{name}")
        out_fd = os.open(
            name, os.O_WRONLY | os.O_CREAT | os.O_EXCL | _NOFOLLOW, 0o644, dir_fd=dst_fd
        )
        try:
            while True:
                chunk = os.read(in_fd, 1 << 20)
                if not chunk:
                    break
                view = memoryview(chunk)
                while view:
                    written = os.write(out_fd, view)
                    view = view[written:]
            os.fchmod(out_fd, 0o644)
        finally:
            os.close(out_fd)
    finally:
        os.close(in_fd)



def validate_src(src: Path, home: Path, uid: int) -> Path | None:
    """Return a vetted cursor theme, or None.

    The helper runs as root for the invoking user. It must never treat an
    arbitrary user-controlled symlink (for example
    ``~/.local/share/icons/Omarchy -> /root``) as a cursor source, and it must
    refuse anything that is not a plausible OmaCursor theme *before* publishing
    a world-readable copy.
    """
    icons = home / ".local/share/icons"
    try:
        real = src.resolve()
    except OSError:
        return None
    if real == icons or not _within(real, icons):
        return None
    if not _owned_by(real, uid):
        return None
    cursors = real / "cursors"
    if cursors.is_symlink() or not cursors.is_dir():
        return None
    if not _owned_by(cursors, uid):
        return None
    index = real / "index.theme"
    if index.is_symlink() or not _owned_by(index, uid):
        return None
    try:
        text = index.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return None
    if "OmaCursor recolor" not in text and "Managed by OmaCursor" not in text:
        return None
    example = cursors / "left_ptr"
    if not (example.exists() or example.is_symlink()):
        return None
    if not _safe_symlinks(real):
        return None
    return real


def _require_cursor_layout(root: Path) -> None:
    """Fail closed unless the staged tree is a usable cursor theme."""
    cursors = root / "cursors"
    if cursors.is_symlink() or not cursors.is_dir():
        raise RuntimeError("staged cursor tree has no cursors/ directory")
    example = cursors / "left_ptr"
    if not (example.exists() or example.is_symlink()):
        raise RuntimeError("staged cursor tree has no left_ptr")
    if not _safe_symlinks(root):
        raise RuntimeError("staged cursor tree contains an unsafe symlink")


def _write_index(path: Path, name: str) -> None:
    path.write_text(
        (
            "[Icon Theme]\n"
            f"Name={name}\n"
            "Comment=OmaCursor recolor of Adwaita for SDDM + session\n"
            "Example=left_ptr\n"
            "Inherits=hicolor\n"
        ),
        encoding="utf-8",
    )


def publish(src: Path, uid: int) -> None:
    staging_root = Path(tempfile.mkdtemp(prefix="omacursor-sddm-"))
    try:
        dest = staging_root / "Omarchy"
        dest.mkdir(mode=0o755)
        # Copy only the cursor payload. A user's icons directory may contain
        # unrelated files, and the root helper must not publish them.
        _copy_tree_nofollow(src / "cursors", dest / "cursors", uid)
        _write_index(dest / "index.theme", "Omarchy")
        (dest / OWNED_MARKER).write_text("omacursor\n", encoding="utf-8")
        _require_cursor_layout(dest)
        _remove_system_omarchy()
        shutil.move(str(dest), str(SYSTEM_ICONS))
        os.chmod(SYSTEM_ICONS, 0o755)
        for root, dirs, files in os.walk(SYSTEM_ICONS):
            for d in dirs:
                os.chmod(Path(root) / d, 0o755)
            for f in files:
                path = Path(root) / f
                if not path.is_symlink():
                    os.chmod(path, 0o644)
    finally:
        shutil.rmtree(staging_root, ignore_errors=True)


def ensure_adwaita_not_hijacked() -> None:
    """Undo the v1.1.3 mistake if a previous sync left Adwaita broken."""
    if ADWAITA_CURSORS.is_symlink():
        ADWAITA_CURSORS.unlink()
    if ADWAITA_CURSORS_BAK.is_dir() and not ADWAITA_CURSORS.exists():
        ADWAITA_CURSORS_BAK.rename(ADWAITA_CURSORS)


def _marker_owns_dest(dest: Path, owned_marker: Path) -> bool:
    """True only when the ownership marker is bound to *this* destination.

    Marker must live inside dest (dest/.omacursor-owned). A sibling marker from
    an older install does not authorize deleting a replaced tree.
    """
    try:
        return owned_marker.is_file() and owned_marker.resolve().parent == dest.resolve()
    except OSError:
        return owned_marker.is_file() and owned_marker.parent == dest


def _replace_dir_preserving(dest: Path, *, prebak: Path, owned_marker: Path) -> None:
    """Remove dest only when we own it; otherwise preserve the current tree.

    Ownership is a marker *inside* a real directory. Symlinks are always treated
    as foreign (we publish real dirs) — rename them aside, never unlink, so a
    user replacement link at default/cursors or sddm cursors survives sync.
    """
    if not (dest.exists() or dest.is_symlink()):
        return
    if dest.is_dir() and not dest.is_symlink() and _marker_owns_dest(dest, owned_marker):
        shutil.rmtree(dest)
        return
    # Foreign dir, symlink, or plain file — keep via rename (never unlink).
    if prebak.exists():
        stamp = time.strftime("%Y%m%d%H%M%S")
        stamped = prebak.with_name(f"{prebak.name}.{stamp}")
        dest.rename(stamped)
    else:
        dest.rename(prebak)


def _restore_dir_from_prebak(dest: Path, *, prebak: Path, owned_marker: Path) -> None:
    """Restore pre-plugin tree only after removing a plugin-owned destination."""
    if dest.exists() or dest.is_symlink():
        if dest.is_symlink():
            # User replacement link — leave it; do not clobber with prebak.
            return
        if dest.is_dir():
            if _marker_owns_dest(dest, owned_marker):
                shutil.rmtree(dest)
            else:
                # Current tree is not ours — leave it.
                return
        else:
            # Plain file without an inside marker — leave it.
            return
    if prebak.exists():
        prebak.rename(dest)


def _omarchy_tree_owned(path: Path) -> bool:
    """True when /usr/share/icons/Omarchy looks like OmaCursor published it."""
    if (path / ".omacursor-owned").is_file():
        return True
    index = path / "index.theme"
    if index.is_file():
        try:
            text = index.read_text(encoding="utf-8", errors="replace")
        except OSError:
            return False
        return "OmaCursor recolor" in text or "Managed by OmaCursor" in text
    return False


def _remove_system_omarchy() -> None:
    """Drop /usr/share/icons/Omarchy only when we own it; else preserve."""
    if not (SYSTEM_ICONS.exists() or SYSTEM_ICONS.is_symlink()):
        return
    if SYSTEM_ICONS.is_symlink():
        SYSTEM_ICONS.unlink()
        return
    if not SYSTEM_ICONS.is_dir():
        SYSTEM_ICONS.unlink()
        return
    if _omarchy_tree_owned(SYSTEM_ICONS):
        shutil.rmtree(SYSTEM_ICONS)
        return
    prebak = Path("/usr/share/icons/Omarchy.omacursor-prebak")
    if prebak.exists():
        stamp = time.strftime("%Y%m%d%H%M%S")
        SYSTEM_ICONS.rename(prebak.with_name(f"Omarchy.omacursor-prebak.{stamp}"))
    else:
        SYSTEM_ICONS.rename(prebak)


def _open_sddm_icons(*, create: bool) -> int | None:
    """Open ``/var/lib/sddm/.icons`` without following any symlink."""
    if SDDM_BASE.is_symlink() or not SDDM_BASE.is_dir():
        return None
    try:
        base_fd = os.open(SDDM_BASE, _O_DIR)
    except OSError:
        return None
    try:
        mode = _entry_mode(base_fd, ".icons")
        if mode is None:
            if not create:
                return None
            os.mkdir(".icons", 0o755, dir_fd=base_fd)
        elif stat.S_ISLNK(mode) or not stat.S_ISDIR(mode):
            raise RuntimeError(f"{SDDM_BASE}/.icons is not a real directory")
        return os.open(".icons", _O_DIR, dir_fd=base_fd)
    finally:
        os.close(base_fd)


def _open_child_dir(
    parent_fd: int, name: str, *, create: bool, aside: bool
) -> int | None:
    """Open a real child directory, never following a symlink."""
    st = _entry_stat(parent_fd, name)
    if st is not None and (stat.S_ISLNK(st.st_mode) or not stat.S_ISDIR(st.st_mode)):
        if not aside:
            return None
        _rename_aside(parent_fd, name, f"{name}.omacursor-aside")
        st = None
    if st is None:
        if not create:
            return None
        os.mkdir(name, 0o755, dir_fd=parent_fd)
    return os.open(name, _O_DIR, dir_fd=parent_fd)


def _write_file_at(
    dir_fd: int,
    name: str,
    data: str,
    *,
    uid: int | None = None,
    gid: int | None = None,
) -> None:
    """Create or rewrite *name* inside *dir_fd* without following a link."""
    base = os.O_WRONLY | _NOFOLLOW | getattr(os, "O_CLOEXEC", 0)
    try:
        fd = os.open(name, base | os.O_CREAT | os.O_EXCL, 0o644, dir_fd=dir_fd)
    except FileExistsError:
        st = _entry_stat(dir_fd, name)
        if st is not None and stat.S_ISLNK(st.st_mode):
            os.unlink(name, dir_fd=dir_fd)
            fd = os.open(name, base | os.O_CREAT | os.O_EXCL, 0o644, dir_fd=dir_fd)
        elif st is not None and stat.S_ISREG(st.st_mode):
            fd = os.open(name, base | os.O_TRUNC, 0o644, dir_fd=dir_fd)
        else:
            raise RuntimeError(f"refusing to write through a non-file at {name!r}")
    try:
        os.write(fd, data.encode("utf-8"))
        os.fchmod(fd, 0o644)
        st = os.fstat(fd)
        if uid is not None and gid is not None and (st.st_uid, st.st_gid) != (uid, gid):
            os.fchown(fd, uid, gid)
    finally:
        os.close(fd)


def _read_head_at(dir_fd: int, name: str, limit: int = 4096) -> bytes:
    try:
        fd = os.open(name, _O_RD, dir_fd=dir_fd)
    except OSError:
        return b""
    try:
        if not stat.S_ISREG(os.fstat(fd).st_mode):
            return b""
        return os.read(fd, limit)
    finally:
        os.close(fd)


def _backup_foreign_file(dir_fd: int, name: str, bak: str, token: bytes) -> None:
    st = _entry_stat(dir_fd, name)
    if st is None:
        return
    if stat.S_ISLNK(st.st_mode):
        # Do not delete a user's symlink; keep it under a timestamped name.
        _rename_aside(dir_fd, name, bak)
        return
    if not stat.S_ISREG(st.st_mode):
        return
    if token in _read_head_at(dir_fd, name):
        return
    if _entry_stat(dir_fd, bak) is None:
        _rename_at(dir_fd, name, bak)
    else:
        # Keep the first foreign file for restore; a later user replacement is
        # still preserved under a timestamped name instead of being overwritten.
        _rename_aside(dir_fd, name, bak)


def _restore_file_at(dir_fd: int, name: str, bak: str, token: bytes) -> None:
    st = _entry_stat(dir_fd, name)
    if st is not None:
        if stat.S_ISLNK(st.st_mode) or not stat.S_ISREG(st.st_mode):
            return
        if token not in _read_head_at(dir_fd, name):
            return
        os.unlink(name, dir_fd=dir_fd)
    st = _entry_stat(dir_fd, bak)
    if st is not None and stat.S_ISREG(st.st_mode):
        _rename_at(dir_fd, bak, name)


def _dir_has_marker(dir_fd: int, marker: str) -> bool:
    return b"omacursor" in _read_head_at(dir_fd, marker)


def _rmtree_at(parent_fd: int, name: str) -> None:
    """Remove a tree relative to *parent_fd*, never following symlinks."""
    fd = os.open(name, _O_DIR, dir_fd=parent_fd)
    try:
        for child in os.listdir(fd):
            st = _entry_stat(fd, child)
            if st is None:
                continue
            if stat.S_ISDIR(st.st_mode):
                _rmtree_at(fd, child)
            else:
                os.unlink(child, dir_fd=fd)
    finally:
        os.close(fd)
    os.rmdir(name, dir_fd=parent_fd)


def _swap_tree_at(parent_fd: int, name: str, new_tree: Path, prebak: str) -> None:
    """Replace an owned tree, or set a foreign one aside, then rename in."""
    st = _entry_stat(parent_fd, name)
    if st is not None:
        ours = False
        if stat.S_ISDIR(st.st_mode):
            child = os.open(name, _O_DIR, dir_fd=parent_fd)
            try:
                ours = _dir_has_marker(child, OWNED_MARKER)
            finally:
                os.close(child)
        if ours:
            _rmtree_at(parent_fd, name)
        elif stat.S_ISDIR(st.st_mode) and _entry_stat(parent_fd, prebak) is None:
            # Keep the pre-plugin tree at the exact name restore looks for.
            # Symlinks and files stay under a timestamped name: restore must not
            # put a user-controlled link back under the greeter's tree.
            _rename_at(parent_fd, name, prebak)
        else:
            _rename_aside(parent_fd, name, prebak)
    os.rename(str(new_tree), name, dst_dir_fd=parent_fd)


def _restore_tree_at(parent_fd: int, name: str, prebak: str) -> None:
    st = _entry_stat(parent_fd, name)
    if st is not None:
        if stat.S_ISLNK(st.st_mode) or not stat.S_ISDIR(st.st_mode):
            return
        child = os.open(name, _O_DIR, dir_fd=parent_fd)
        try:
            ours = _dir_has_marker(child, OWNED_MARKER)
        finally:
            os.close(child)
        if not ours:
            return
        _rmtree_at(parent_fd, name)
    if _entry_stat(parent_fd, prebak) is not None:
        _rename_at(parent_fd, prebak, name)


def _chown_tree(root: Path, uid: int, gid: int) -> None:
    """chown a root-owned staging tree; symlinks are changed, never followed."""
    st = os.lstat(root)
    if (st.st_uid, st.st_gid) == (uid, gid):
        return
    os.chown(root, uid, gid, follow_symlinks=False)
    for dirpath, dirnames, filenames in os.walk(root):
        for name in dirnames + filenames:
            os.chown(Path(dirpath) / name, uid, gid, follow_symlinks=False)


def _stage_sddm_cursors(uid: int, gid: int) -> tuple[Path, Path]:
    staging = Path(tempfile.mkdtemp(prefix="omacursor-sddm-user-"))
    tree = staging / "cursors"
    _copy_tree_nofollow(SYSTEM_ICONS / "cursors", tree, None)
    (tree / OWNED_MARKER).write_text("omacursor\n", encoding="utf-8")
    _chown_tree(tree, uid, gid)
    return staging, tree


def _point_sddm_defaults() -> None:
    """Publish cursors for the SDDM greeter through fd-relative operations.

    ``/var/lib/sddm/.icons`` is user-reachable on some installs, so a symlink
    planted at ``default`` (or any component below it) must never be followed:
    the old code wrote through it and recursively chowned the target to sddm.
    Here every component is opened with ``O_NOFOLLOW``; foreign entries are
    renamed aside with dir_fd and nothing outside the staged tree is chowned.
    """
    try:
        pw = pwd.getpwnam("sddm")
        uid, gid = pw.pw_uid, pw.pw_gid
    except KeyError:
        uid, gid = os.geteuid(), os.getegid()

    icons_fd = _open_sddm_icons(create=True)
    if icons_fd is None:
        return
    staging: Path | None = None
    try:
        default_fd = _open_child_dir(icons_fd, "default", create=True, aside=True)
        if default_fd is None:
            return
        try:
            _backup_foreign_file(
                default_fd, "index.theme", "index.theme.omacursor-bak",
                b"Managed by OmaCursor",
            )
            _write_file_at(default_fd, "index.theme", SDDM_INDEX, uid=uid, gid=gid)
            # Readable by the greeter; ownership stays with root. Handing the
            # parent directories to sddm was what let a planted symlink turn
            # into a recursive chown of its target.
            os.fchmod(default_fd, 0o755)
            os.fchmod(icons_fd, 0o755)
            staging, tree = _stage_sddm_cursors(uid, gid)
            _swap_tree_at(default_fd, "cursors", tree, SDDM_CURSORS_PREBAK_NAME)
            # Legacy sibling marker from older installs.
            try:
                os.unlink(OWNED_MARKER, dir_fd=default_fd)
            except FileNotFoundError:
                pass
        finally:
            os.close(default_fd)
    finally:
        os.close(icons_fd)
        if staging is not None:
            shutil.rmtree(staging, ignore_errors=True)


def _rmdir_if_empty_at(parent_fd: int, name: str) -> None:
    st = _entry_stat(parent_fd, name)
    if st is None or stat.S_ISLNK(st.st_mode) or not stat.S_ISDIR(st.st_mode):
        return
    fd = os.open(name, _O_DIR, dir_fd=parent_fd)
    try:
        if os.listdir(fd):
            return
    finally:
        os.close(fd)
    try:
        os.rmdir(name, dir_fd=parent_fd)
    except OSError:
        pass


def _restore_sddm_defaults() -> None:
    """Undo only what OmaCursor put under /var/lib/sddm/.icons."""
    icons_fd = _open_sddm_icons(create=False)
    if icons_fd is None:
        return
    try:
        default_fd = _open_child_dir(icons_fd, "default", create=False, aside=False)
        if default_fd is not None:
            try:
                _restore_tree_at(
                    default_fd, "cursors", SDDM_CURSORS_PREBAK_NAME
                )
                try:
                    os.unlink(OWNED_MARKER, dir_fd=default_fd)
                except FileNotFoundError:
                    pass
                _restore_file_at(
                    default_fd,
                    "index.theme",
                    "index.theme.omacursor-bak",
                    b"Managed by OmaCursor",
                )
            finally:
                os.close(default_fd)
        _rmdir_if_empty_at(icons_fd, "default")
    finally:
        os.close(icons_fd)
    if SDDM_BASE.is_symlink() or not SDDM_BASE.is_dir():
        return
    try:
        base_fd = os.open(SDDM_BASE, _O_DIR)
    except OSError:
        return
    try:
        _rmdir_if_empty_at(base_fd, ".icons")
    finally:
        os.close(base_fd)


def point_system_default() -> None:
    """Self-contained default theme (cursors/) — do NOT touch Adwaita."""
    ensure_adwaita_not_hijacked()

    DEFAULT_DIR.mkdir(parents=True, exist_ok=True)
    if DEFAULT_THEME.is_file() and not DEFAULT_BAK.is_file():
        shutil.copy2(DEFAULT_THEME, DEFAULT_BAK)

    # Full cursor tree under default/ so "default" works without inheriting Adwaita.
    _replace_dir_preserving(
        DEFAULT_CURSORS, prebak=DEFAULT_CURSORS_PREBAK, owned_marker=DEFAULT_CURSORS_OWNED
    )
    _copy_tree_nofollow(SYSTEM_ICONS / "cursors", DEFAULT_CURSORS)
    DEFAULT_CURSORS_OWNED.write_text("omacursor\n", encoding="utf-8")
    DEFAULT_CURSORS_OWNED_LEGACY.unlink(missing_ok=True)

    DEFAULT_THEME.write_text(
        (
            "[Icon Theme]\n"
            "# Managed by OmaCursor — self-contained cursors/ (Adwaita untouched)\n"
            "Name=default\n"
            "Comment=OmaCursor SDDM/default cursor theme\n"
            "Example=left_ptr\n"
            "Inherits=hicolor\n"
        ),
        encoding="utf-8",
    )
    os.chmod(DEFAULT_THEME, 0o644)

    try:
        _point_sddm_defaults()
    except (OSError, RuntimeError) as exc:
        print(
            f"omacursor-sync-sddm: SDDM cursor tree left untouched: {exc}",
            file=sys.stderr,
        )


def ensure_wiring(size: int) -> None:
    HYPR_CFG.parent.mkdir(parents=True, exist_ok=True)
    HYPR_CFG.write_text(HYPR_LUA.format(size=size), encoding="utf-8")
    os.chmod(HYPR_CFG, 0o644)

    LIBDIR.mkdir(parents=True, exist_ok=True)
    COMPOSITOR.write_text(COMPOSITOR_SH.format(size=size), encoding="utf-8")
    os.chmod(COMPOSITOR, 0o755)

    LOG.touch(exist_ok=True)
    os.chmod(LOG, 0o666)

    CONF.parent.mkdir(parents=True, exist_ok=True)
    CONF.write_text(
        (
            "# Generated by OmaCursor — SDDM Wayland/Hyprland cursor wiring.\n"
            "# Does NOT modify Adwaita. Uses Omarchy + self-contained default/cursors.\n"
            "[Theme]\n"
            "CursorTheme=Omarchy\n"
            f"CursorSize={size}\n"
            "\n"
            "[General]\n"
            f"GreeterEnvironment=XCURSOR_THEME=Omarchy,XCURSOR_SIZE={size}\n"
            "\n"
            "[Wayland]\n"
            f"CompositorCommand={COMPOSITOR}\n"
        ),
        encoding="utf-8",
    )
    os.chmod(CONF, 0o644)


def restore_system_default() -> None:
    ensure_adwaita_not_hijacked()
    had_default_prebak = DEFAULT_CURSORS_PREBAK.exists()
    _restore_dir_from_prebak(
        DEFAULT_CURSORS, prebak=DEFAULT_CURSORS_PREBAK, owned_marker=DEFAULT_CURSORS_OWNED
    )
    DEFAULT_CURSORS_OWNED_LEGACY.unlink(missing_ok=True)
    if DEFAULT_BAK.is_file():
        shutil.copy2(DEFAULT_BAK, DEFAULT_THEME)
        DEFAULT_BAK.unlink()
    elif not had_default_prebak and not DEFAULT_CURSORS.exists():
        # We created default/index.theme from scratch — reset to stock inherit.
        if DEFAULT_THEME.is_file():
            DEFAULT_THEME.write_text(
                "[Icon Theme]\nInherits=Adwaita\n",
                encoding="utf-8",
            )

    # SDDM home icons: only touch plugin-owned paths under .icons/default/.
    # Never wipe the whole /var/lib/sddm/.icons tree (other themes may live there).
    try:
        _restore_sddm_defaults()
    except (OSError, RuntimeError) as exc:
        print(
            f"omacursor-sync-sddm: SDDM cursor tree left untouched: {exc}",
            file=sys.stderr,
        )


def revert() -> None:
    _remove_system_omarchy()
    # If we preserved a foreign Omarchy tree as prebak and our owned tree is gone,
    # put the foreign tree back.
    prebak = Path("/usr/share/icons/Omarchy.omacursor-prebak")
    if prebak.exists() and not SYSTEM_ICONS.exists():
        prebak.rename(SYSTEM_ICONS)
    restore_system_default()
    for path in (
        CONF,
        HYPR_CFG,
        COMPOSITOR,
        SUDOERS,
        Path("/etc/sudoers.d/omacursor-sddm"),
        LOG,
    ):
        if path.is_file() or path.is_symlink():
            path.unlink()
    sync = LIBDIR / "sync-sddm"
    if sync.is_file():
        sync.unlink()
    try:
        LIBDIR.rmdir()
    except OSError:
        pass


def main(argv: list[str] | None = None) -> int:
    if os.geteuid() != 0:
        print("omacursor-sync-sddm: must run as root (sudo -n ...)", file=sys.stderr)
        return 1

    args = list(argv if argv is not None else sys.argv[1:])
    if "--revert" in args:
        revert()
        print("omacursor-sync-sddm: reverted", file=sys.stderr)
        return 0

    home = invoking_home()
    src = resolve_src(home)
    if src is None:
        print(f"omacursor-sync-sddm: no cursor theme under {home}", file=sys.stderr)
        return 2

    uid = invoking_uid(home)
    if uid is None:
        print("omacursor-sync-sddm: cannot determine invoking user", file=sys.stderr)
        return 2
    safe = validate_src(src, home, uid)
    if safe is None:
        print(
            f"omacursor-sync-sddm: refusing unsafe cursor source {src} "
            f"(need a user-owned OmaCursor theme under {home}/.local/share/icons)",
            file=sys.stderr,
        )
        return 3
    src = safe

    size = 24
    env_size = os.environ.get("XCURSOR_SIZE")
    if env_size and env_size.isdigit():
        size = int(env_size)

    try:
        publish(src, uid)
    except (OSError, RuntimeError) as exc:
        print(
            f"omacursor-sync-sddm: refusing to publish {src}: {exc}",
            file=sys.stderr,
        )
        return 4
    point_system_default()
    ensure_wiring(size)
    # Keep the installed helper identical to this file
    try:
        shutil.copy2(Path(__file__).resolve(), LIBDIR / "sync-sddm")
        os.chmod(LIBDIR / "sync-sddm", 0o755)
    except OSError:
        pass
    print(f"omacursor-sync-sddm: published {src} → {SYSTEM_ICONS}", file=sys.stderr)
    print("omacursor-sync-sddm: default/cursors populated; Adwaita left alone", file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main())
