#!/usr/bin/env bash
# Thin launcher so menu actions and hooks can call omacursor-* by name.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export OMACURSOR_PLUGIN_DIR="${OMACURSOR_PLUGIN_DIR:-$(cd "$here/.." && pwd)}"
exec python3 "$OMACURSOR_PLUGIN_DIR/lib/omacursor.py" "$@"
